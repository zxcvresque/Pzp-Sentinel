generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DONOR
  DEV
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Currency {
  INR
  USD
}

enum DonateCadence {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
  OFF
}

enum DonationFrequency {
  ONE_TIME
  MONTHLY
}

enum ReminderUnit {
  DAY
  WEEK
  MONTH
}

enum PaymentMethod {
  UPI
  RAZORPAY
  BMC
  BANK
  OTHER
}

enum RazorpayOrderStatus {
  CREATED
  PAID
  FAILED
  EXPIRED
}

enum Direction {
  IN
  OUT
}

enum TxStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TxType {
  DONATION
  EXPENSE
  SUBSCRIPTION
  OTHER
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum Frequency {
  WEEKLY
  MONTHLY
  YEARLY
  ONE_TIME
  LIFETIME
}

enum FormLayout {
  SECTION_CARDS
  ACCENT_RAILS
  NUMBERED_WORKFLOW
  INFORMATION_BANDS
}

enum DocumentKind {
  RECEIPT
  INVOICE
  CONTRACT
  LICENCE
  PROOF
  OTHER
}

enum DocumentStatus {
  DRAFT
  LINKED
  ABANDONED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjStatus {
  ACTIVE
  ARCHIVED
  ON_HOLD
}

enum ProjectMemberRole {
  LEAD
  MEMBER
  VIEWER
}

enum ReminderFreq {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ReminderRepeatUnit {
  MINUTE
  HOUR
  DAY
  WEEK
  MONTH
}

enum Channel {
  BOT
  WEB
  BOTH
}

enum BroadcastAudienceScope {
  ADMINS
  DONORS
  DEVS
  EVERYONE
}

enum BroadcastRecipientMode {
  ALL
  SELECTED
}

model User {
  id                String     @id @default(cuid())
  telegramId        String     @unique
  telegramUser      String
  name              String
  photoUrl          String?
  themeColor        String     @default("#6FD1D7")
  formLayout        FormLayout @default(SECTION_CARDS)
  onboardingVersion Int        @default(0)
  savedColors       String[]   @default([])
  chatId            String?
  roles             Role[]
  status            UserStatus @default(ACTIVE)
  dmPreferences     String[]   @default(["TX_PENDING", "TX_APPROVED", "TX_REJECTED", "TASK_ASSIGNED", "REMINDER", "SYSTEM", "ROLE_ASSIGNED", "CREDENTIAL_ASSIGNED", "CREDENTIAL_REVIEWED", "USER_REGISTERED"])
  inAppPreferences  String[]   @default(["TX_PENDING", "TX_APPROVED", "TX_REJECTED", "TASK_ASSIGNED", "REMINDER", "SYSTEM", "ROLE_ASSIGNED", "CREDENTIAL_ASSIGNED", "CREDENTIAL_REVIEWED", "USER_REGISTERED"])
  preferredCurrency Currency   @default(USD)
  githubUsername    String?
  createdById       String?
  createdBy         User?      @relation("CreatedByAdmin", fields: [createdById], references: [id])
  createdUsers      User[]     @relation("CreatedByAdmin")
  createdAt         DateTime   @default(now())

  otpCode        String?
  otpExpiresAt   DateTime?
  otpAttempts    Int       @default(0)
  otpRequestedAt DateTime?
  otpLockedUntil DateTime?

  transactionsCreated          Transaction[]                  @relation("TxCreatedBy")
  transactionsFrom             Transaction[]                  @relation("TxFromUser")
  transactionsReviewed         Transaction[]                  @relation("TxReviewedBy")
  transactionsVoided           Transaction[]                  @relation("TxVoidedBy")
  tasksAssigned                Task[]                         @relation("TaskAssignee")
  tasksCreated                 Task[]                         @relation("TaskCreatedBy")
  remindersCreated             Reminder[]
  broadcastSchedules           ScheduledBroadcast[]
  projectMembers               Project[]                      @relation("ProjectMembers")
  projectMemberships           ProjectMember[]
  projectsCreated              Project[]                      @relation("ProjectCreatedBy")
  projectsArchived             Project[]                      @relation("ProjectArchivedBy")
  tasksArchived                Task[]                         @relation("TaskArchivedBy")
  remindersOwned               Reminder[]                     @relation("ReminderOwner")
  remindersAcknowledged        Reminder[]                     @relation("ReminderAcknowledgedBy")
  maintainedVpsServers         VpsServer[]                    @relation("VpsMaintainers")
  vpsAlertPreferences          VpsAlertPreference[]
  credentialsCreated           Credential[]                   @relation("CredCreatedBy")
  credentialsReviewed          Credential[]                   @relation("CredReviewedBy")
  credentialAccess             CredentialAccess[]             @relation("CredAccessUser")
  documentsUploaded            Document[]                     @relation("DocumentUploader")
  notifications                Notification[]
  razorpayOrders               RazorpayOrder[]
  razorpaySubscriptions        RazorpaySubscription[]
  razorpaySubscriptionFeedback RazorpaySubscriptionFeedback[]
  oneTimeInvitesCreated        OneTimeDonationInvite[]        @relation("OneTimeInviteCreator")
  bmcCheckoutIntents           BmcCheckoutIntent[]
  bmcSupporterLinks            BmcSupporterLink[]
  bmcSubscriptionFeedback      BmcSubscriptionFeedback[]

  // Donor donate-reminder settings (default monthly; OFF disables nudges).
  donateReminderCadence  DonateCadence @default(MONTHLY)
  lastDonateReminderAt   DateTime?
  // A donor who explicitly chooses monthly giving is reminded on this local
  // day-of-month instead of the generic 5th-of-the-month default.
  donateReminderAnchorAt DateTime?
  // CUSTOM cadence: remind every N units (e.g. every 3 DAYs / 2 WEEKs / 1 MONTH).
  donateReminderEveryN   Int?
  donateReminderUnit     ReminderUnit?
  // Time of day the nudge fires (minutes from local midnight; 540 = 09:00) in the
  // donor's timezone. Applies to ALL cadences. Default IST.
  donateReminderTimeMin  Int           @default(540)
  donateReminderTz       String        @default("Asia/Kolkata")

  // Donor checkout access. BMC is available by default; Razorpay remains
  // available only while an administrator has enabled it for the donor.
  bmcAccess                 Boolean   @default(true)
  razorpayAccess            Boolean   @default(false)
  razorpayAccessRequestedAt DateTime?
}

model Transaction {
  id                            String            @id @default(cuid())
  amount                        Decimal
  currency                      Currency          @default(INR)
  method                        PaymentMethod     @default(UPI)
  // Provider-specific rail captured from verified payment data, for example
  // "upi:phonepe", "card:visa", "wallet:paytm", or "netbanking".
  paymentMethodDetail           String?
  direction                     Direction
  type                          TxType            @default(OTHER)
  donationFrequency             DonationFrequency @default(ONE_TIME)
  // Provider payment ID for recurring rails whose charges do not use a
  // Sentinel RazorpayOrder. Unique so webhook retries cannot duplicate income.
  providerPaymentId             String?           @unique
  razorpaySubscriptionId        String?
  // Encrypted provider metadata (payer email/name/note/payment context). Never
  // expose this ciphertext through general transaction APIs.
  providerDetailsEncrypted      String?
  // Provider-backed methods are trusted only when this flag was set by a
  // verified checkout/webhook/reconciliation path, never by a manual form.
  providerVerified              Boolean           @default(false)
  providerState                 String            @default("NONE")
  // Scheduler-created service renewals remain pending until an admin approves.
  isAutomatedRenewal            Boolean           @default(false)
  advancesServiceCycle          Boolean           @default(false)
  automatedRenewalKey           String?           @unique
  workflowId                    String?
  reversalOfId                  String?
  reversalOf                    Transaction?      @relation("TransactionReversals", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals                     Transaction[]     @relation("TransactionReversals")
  donorAppealMessage            String?
  donorAppealedAt               DateTime?
  fromUserId                    String?
  fromUser                      User?             @relation("TxFromUser", fields: [fromUserId], references: [id])
  description                   String
  proofFileId                   String?
  attachments                   String[]          @default([])
  date                          DateTime          @default(now())
  status                        TxStatus          @default(PENDING)
  isTest                        Boolean           @default(false)
  reviewedById                  String?
  reviewedBy                    User?             @relation("TxReviewedBy", fields: [reviewedById], references: [id])
  reviewNote                    String?
  voidedAt                      DateTime?
  voidedById                    String?
  voidedBy                      User?             @relation("TxVoidedBy", fields: [voidedById], references: [id])
  voidReason                    String?
  bmcEventId                    String?           @unique
  // Durable outbox state for public funds-group thank-yous. Only eligible
  // DONOR-owned donations are claimed; stale claims can be retried safely.
  donationAnnouncementClaimedAt DateTime?
  donationAnnouncedAt           DateTime?
  createdById                   String
  createdBy                     User              @relation("TxCreatedBy", fields: [createdById], references: [id])
  createdAt                     DateTime          @default(now())
  serviceId                     String?
  linkedService                 Service?          @relation("ServiceTransactions", fields: [serviceId], references: [id], onDelete: SetNull)
  documents                     Document[]

  service           Service?           @relation("SubPaidTx")
  auditLogs         AuditLog[]
  razorpayOrder     RazorpayOrder?
  bmcWebhookEvents  BmcWebhookEvent[]
  bmcCheckoutIntent BmcCheckoutIntent?

  @@index([razorpaySubscriptionId, date])
  @@index([serviceId, date])
  @@index([serviceId, isAutomatedRenewal, status])
  @@index([workflowId])
  @@index([donationAnnouncedAt, date])
}

// Server-owned Razorpay order state. Checkout responses are never trusted until
// they match one of these records and Razorpay confirms the payment is captured.
model RazorpayOrder {
  id                String                 @id @default(cuid())
  razorpayOrderId   String                 @unique
  paymentId         String?                @unique
  receipt           String                 @unique
  userId            String?
  user              User?                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  inviteId          String?                @unique
  invite            OneTimeDonationInvite? @relation(fields: [inviteId], references: [id], onDelete: Restrict)
  transactionId     String?                @unique
  transaction       Transaction?           @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  amount            Int // smallest currency unit (paise for INR)
  currency          Currency               @default(INR)
  description       String
  donationFrequency DonationFrequency      @default(ONE_TIME)
  testMode          Boolean                @default(false)
  status            RazorpayOrderStatus    @default(CREATED)
  paidAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([userId, createdAt])
}

// A custom-amount monthly mandate. Razorpay plans have fixed amounts, so the
// server creates a plan for the selected amount and then creates a subscription
// from that plan. Subsequent charges arrive through subscription webhooks.
model RazorpaySubscription {
  id                     String                         @id @default(cuid())
  razorpaySubscriptionId String                         @unique
  razorpayPlanId         String
  authorizationPaymentId String?                        @unique
  userId                 String
  user                   User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount                 Int
  currency               Currency                       @default(INR)
  description            String
  status                 String                         @default("CREATED")
  totalCount             Int                            @default(1200)
  paidCount              Int                            @default(0)
  remainingCount         Int?
  nextChargeAt           DateTime?
  endedAt                DateTime?
  cancelInitiatedBy      String?
  pauseInitiatedBy       String?
  lastWebhookEvent       String?
  lastWebhookAt          DateTime?
  testMode               Boolean                        @default(false)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  feedback               RazorpaySubscriptionFeedback[]

  @@index([userId, createdAt])
}

enum RazorpayFeedbackStage {
  ASK_WANTED
  ASK_CANCELLED
  AWAITING_REASON
  COMPLETED
}

model RazorpaySubscriptionFeedback {
  id                     String                @id @default(cuid())
  subscriptionId         String
  subscription           RazorpaySubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  triggerAction          String
  stage                  RazorpayFeedbackStage @default(ASK_WANTED)
  wantedToDonate         Boolean?
  deliberateCancellation Boolean?
  reason                 String?
  requestedAt            DateTime              @default(now())
  respondedAt            DateTime?
  updatedAt              DateTime              @updatedAt

  @@index([subscriptionId, stage, requestedAt])
  @@index([userId, stage, requestedAt])
}

model OneTimeDonationInvite {
  id            String         @id @default(cuid())
  tokenHash     String         @unique
  guestName     String
  telegramUser  String?
  telegramId    String?
  note          String?
  allowRazorpay Boolean        @default(false)
  createdById   String
  createdBy     User           @relation("OneTimeInviteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  expiresAt     DateTime
  claimedAt     DateTime?
  usedAt        DateTime?
  revokedAt     DateTime?
  order         RazorpayOrder?
  createdAt     DateTime       @default(now())

  @@index([createdById, createdAt])
  @@index([expiresAt])
}

model RazorpayWebhookEvent {
  id               String   @id @default(cuid())
  eventId          String   @unique
  eventType        String
  resourceId       String?
  payload          Json?
  encryptedPayload String?
  // PROCESSED default keeps historical receipt rows from appearing as false
  // reconciliation failures; new webhook ingestion writes RECEIVED explicitly.
  status           String   @default("PROCESSED")
  createdAt        DateTime @default(now())

  @@index([status, eventType, createdAt])
  @@index([resourceId])
}

// Durable receipt log for Buy Me a Coffee webhook deliveries. The event key
// makes retries idempotent while the raw payload preserves provider data for
// support/debugging without exposing it to donors.
model BmcWebhookEvent {
  id                String       @id @default(cuid())
  eventKey          String       @unique
  providerEventId   String?
  eventType         String
  liveMode          Boolean      @default(true)
  attempt           Int          @default(1)
  resourceId        String?
  supporterName     String?
  supporterId       String?
  supporterEmail    String?
  amount            Decimal?
  currency          Currency?
  status            String       @default("PROCESSING")
  attributionStatus String       @default("PENDING")
  // New deliveries are encrypted at rest. payload remains nullable only for
  // compatibility with historical rows written before field encryption.
  payload           Json?
  encryptedPayload  String?
  transactionId     String?
  transaction       Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  processedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([eventType, createdAt])
  @@index([resourceId])
  @@index([transactionId])
  @@index([supporterId])
  @@index([attributionStatus, createdAt])
}

// A short-lived, single-use code shown to a signed-in donor before BMC opens.
// Only its SHA-256 hash is stored; the code itself is returned once to the UI.
model BmcCheckoutIntent {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash          String            @unique
  donationFrequency DonationFrequency @default(ONE_TIME)
  expiresAt         DateTime
  consumedAt        DateTime?
  transactionId     String?           @unique
  transaction       Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())

  @@index([userId, expiresAt])
}

// A BMC supporter ID becomes trusted only after a signed webhook carries a
// valid donor-bound checkout code, or an administrator reconciles a payment.
model BmcSupporterLink {
  id                        String            @id @default(cuid())
  accountSlug               String
  supporterId               String
  supporterEmail            String?
  supporterDetailsEncrypted String?
  userId                    String
  user                      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  donationFrequency         DonationFrequency @default(ONE_TIME)
  verifiedAt                DateTime          @default(now())
  lastSeenAt                DateTime          @default(now())
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@unique([accountSlug, supporterId])
  @@index([userId])
}

model BmcSubscriptionFeedback {
  id                     String                @id @default(cuid())
  eventKey               String                @unique
  userId                 String
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  supporterId            String?
  supporterName          String
  triggerType            String
  amount                 Decimal?
  currency               Currency?
  stage                  RazorpayFeedbackStage @default(ASK_WANTED)
  wantedToDonate         Boolean?
  deliberateCancellation Boolean?
  reason                 String?
  requestedAt            DateTime              @default(now())
  respondedAt            DateTime?
  updatedAt              DateTime              @updatedAt

  @@index([userId, stage, requestedAt])
}

model Service {
  id              String             @id @default(cuid())
  category        String
  name            String
  columns         Json?
  entries         Json?
  // Optional subscription / cost tracking
  price           Decimal?
  currency        Currency?
  frequency       Frequency?
  planUrl         String?
  expiryDate      DateTime?
  lastRenewalDate DateTime?
  autoRenew       Boolean            @default(false)
  workflowId      String?
  paidTxId        String?            @unique
  paidTransaction Transaction?       @relation("SubPaidTx", fields: [paidTxId], references: [id])
  status          SubStatus?
  attachments     String[]           @default([])
  archivedAt      DateTime?
  archivedById    String?
  // Optional link back to the VPS server that created this subscription.
  // SetNull so deleting a server preserves the Service + its transaction history.
  vpsServerId     String?            @unique
  vpsServer       VpsServer?         @relation("VpsSub", fields: [vpsServerId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
  transactions    Transaction[]      @relation("ServiceTransactions")
  credentials     Credential[]
  reminders       Reminder[]
  alerts          OperationalAlert[]
  documents       Document[]

  @@index([archivedAt, status])
  @@index([workflowId])
}

// Admin-managed provider accounts used by the Services > API Usage dashboard.
// authCookie and apiKey are always encrypted with CREDENTIAL_ENC_KEY before
// they are written. lastSnapshot deliberately contains usage metadata only.
model ApiUsageAccount {
  id            String    @id @default(cuid())
  provider      String    @default("OPENCODE_GO")
  name          String
  workspaceId   String
  authCookie    String
  apiKey        String?
  expiresAt     DateTime?
  enabled       Boolean   @default(true)
  lastSnapshot  Json?
  lastFetchedAt DateTime?
  lastError     String?
  lastErrorAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([provider, enabled])
}

model Project {
  id            String          @id @default(cuid())
  name          String
  repoUrl       String?
  trackedRepoId String?
  trackedRepo   TrackedRepo?    @relation(fields: [trackedRepoId], references: [id], onDelete: SetNull)
  description   String
  status        ProjStatus      @default(ACTIVE)
  members       User[]          @relation("ProjectMembers")
  memberships   ProjectMember[]
  createdById   String?
  createdBy     User?           @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt    DateTime?
  archivedById  String?
  archivedBy    User?           @relation("ProjectArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  tasks         Task[]
  tags          Tag[]
  vpsServers    VpsServer[]     @relation("ProjectVpsServers")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, archivedAt])
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([projectId, userId])
  @@index([userId, role])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#c8ff00")
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]   @relation("TaskTags")

  @@unique([projectId, name])
  @@index([projectId])
}

model Task {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id])
  title        String
  description  String?
  assigneeId   String?
  assignee     User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  status       TaskStatus @default(BACKLOG)
  priority     Priority   @default(MEDIUM)
  startDate    DateTime?
  deadline     DateTime?
  parentId     String?
  parent       Task?      @relation("Subtasks", fields: [parentId], references: [id])
  subtasks     Task[]     @relation("Subtasks")
  tags         Tag[]      @relation("TaskTags")
  createdById  String
  createdBy    User       @relation("TaskCreatedBy", fields: [createdById], references: [id])
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?      @relation("TaskArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([projectId, archivedAt, status])
  @@index([assigneeId, archivedAt])
}

model Reminder {
  id               String              @id @default(cuid())
  createdById      String
  createdBy        User                @relation(fields: [createdById], references: [id])
  message          String
  frequency        ReminderFreq        @default(ONCE)
  repeatEvery      Int?
  repeatUnit       ReminderRepeatUnit?
  nextFire         DateTime
  lastFiredAt      DateTime?
  active           Boolean             @default(true)
  channel          Channel             @default(BOTH)
  ownerId          String?
  owner            User?               @relation("ReminderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?               @relation("ReminderAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  snoozedUntil     DateTime?
  escalationAt     DateTime?
  escalatedAt      DateTime?
  lastError        String?
  // Kept for compatibility with existing databases. Admin reminders always
  // write ADMIN here; the audience is no longer configurable in the UI/API.
  recipientRoles   Role[]              @default([ADMIN])
  createdAt        DateTime            @default(now())
  serviceId        String?
  service          Service?            @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([active, nextFire])
  @@index([serviceId, active])
}

model ScheduledBroadcast {
  id            String                 @id @default(cuid())
  createdById   String
  createdBy     User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  title         String
  message       String
  audience      BroadcastAudienceScope
  recipientMode BroadcastRecipientMode @default(ALL)
  recipientIds  String[]               @default([])
  sendSentinel  Boolean                @default(true)
  sendTelegram  Boolean                @default(false)
  highPriority  Boolean                @default(true)
  repeatEvery   Int
  repeatUnit    ReminderRepeatUnit
  nextFire      DateTime
  lastFiredAt   DateTime?
  lastError     String?
  active        Boolean                @default(true)
  createdAt     DateTime               @default(now())

  @@index([active, nextFire])
}

enum CredStatus {
  APPROVED
  PENDING
  REJECTED
}

// No @default: every share must explicitly pick a mode (force-choice).
enum CredAccessLevel {
  PUBLIC_KEY
  FULL
}

model Credential {
  id           String             @id @default(cuid())
  platform     String
  label        String
  value        String
  accesses     CredentialAccess[]
  status       CredStatus         @default(APPROVED)
  createdById  String
  createdBy    User               @relation("CredCreatedBy", fields: [createdById], references: [id])
  reviewedById String?
  reviewedBy   User?              @relation("CredReviewedBy", fields: [reviewedById], references: [id])
  parentId     String?
  parent       Credential?        @relation("CredentialRevisions", fields: [parentId], references: [id])
  revisions    Credential[]       @relation("CredentialRevisions")
  // VPS link: when this credential mirrors a VpsServer secret.
  vpsServerId  String?
  vpsServer    VpsServer?         @relation(fields: [vpsServerId], references: [id], onDelete: Cascade)
  serviceId    String?
  service      Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  expiresAt    DateTime?
  credKind     String? // "VPS_PASSWORD" | "VPS_SSH_KEY" — used to find/sync the linked row
  deletedAt    DateTime?
  purgeAfter   DateTime?
  deletedById  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  alerts       OperationalAlert[]

  @@index([vpsServerId])
  @@index([serviceId])
  @@index([expiresAt])
  @@index([deletedAt, purgeAfter])
}

model Document {
  id                   String         @id @default(cuid())
  url                  String         @unique
  originalName         String
  contentType          String
  size                 Int
  kind                 DocumentKind   @default(OTHER)
  status               DocumentStatus @default(DRAFT)
  uploaderId           String
  uploader             User           @relation("DocumentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  transactionId        String?
  transaction          Transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  serviceId            String?
  service              Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  workflowId           String?
  telegramFileId       String?
  telegramMessageId    Int?
  telegramArchivedAt   DateTime?
  telegramArchiveError String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([transactionId, kind])
  @@index([serviceId, kind])
  @@index([uploaderId, status, createdAt])
  @@index([workflowId])
}

model OperationalAlert {
  id           String      @id @default(cuid())
  fingerprint  String      @unique
  kind         String
  severity     String      @default("NORMAL")
  title        String
  message      String
  status       String      @default("OPEN")
  dueAt        DateTime?
  serviceId    String?
  service      Service?    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  credentialId String?
  credential   Credential? @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  vpsServerId  String?
  vpsServer    VpsServer?  @relation(fields: [vpsServerId], references: [id], onDelete: Cascade)
  resolvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, severity, dueAt])
  @@index([serviceId, status])
  @@index([credentialId, status])
  @@index([vpsServerId, status])
}

// Per-dev access to a credential. Replaces the old implicit M2M `assignees`.
model CredentialAccess {
  id           String          @id @default(cuid())
  credentialId String
  credential   Credential      @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation("CredAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  accessLevel  CredAccessLevel
  devPublicKey String? // PUBLIC_KEY mode: the dev's own submitted key; null until submitted
  granted      Boolean         @default(false)
  grantedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([credentialId, userId])
  @@index([userId])
}

model AuditLog {
  id            String       @id @default(cuid())
  userId        String
  action        String
  entityType    String
  entityId      String
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  before        Json?
  after         Json?
  ipAddress     String?
  userAgent     String?
  requestId     String?
  workflowId    String?
  outcome       String       @default("SUCCESS")
  errorMessage  String?
  timestamp     DateTime     @default(now())

  @@index([requestId])
  @@index([workflowId, timestamp])
  @@index([outcome, timestamp])
}

enum NotifType {
  TX_PENDING
  TX_APPROVED
  TX_REJECTED
  TASK_ASSIGNED
  REMINDER
  SYSTEM
  ROLE_ASSIGNED
  CREDENTIAL_ASSIGNED
  CREDENTIAL_REVIEWED
  USER_REGISTERED
  VPS_ALERT_SETTINGS
  VPS_ALERT
}

model Notification {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  type              NotifType
  title             String
  message           String
  read              Boolean   @default(false)
  entityId          String?
  priority          String    @default("NORMAL")
  telegramStatus    String    @default("NOT_REQUESTED")
  telegramAttempts  Int       @default(0)
  telegramLastError String?
  telegramSentAt    DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([telegramStatus, createdAt])
}

enum LoginTokenStatus {
  PENDING
  VERIFIED
  EXPIRED
}

model LoginToken {
  id         String           @id @default(cuid())
  nonce      String           @unique
  telegramId String?
  status     LoginTokenStatus @default(PENDING)
  expiresAt  DateTime
  createdAt  DateTime         @default(now())
}

model TrackedRepo {
  id        String    @id @default(cuid())
  name      String // e.g. "Pzp-Sentinel"
  fullName  String    @unique // e.g. "Spamverse/Pzp-Sentinel"
  url       String
  addedById String
  createdAt DateTime  @default(now())
  projects  Project[]
}

model VpsServer {
  id               String               @id @default(cuid())
  name             String
  token            String               @unique
  provider         String               @default("")
  ip               String               @default("")
  platform         String               @default("")
  username         String               @default("root")
  sshPort          Int                  @default(22)
  password         String               @default("")
  sshKeyFileUrl    String?
  sshKeyFileName   String?
  accessPublicKeys String               @default("")
  tags             String[]             @default([])
  notes            String               @default("")
  specs            Json                 @default("{}")
  processHealth    Json                 @default("[]")
  releaseVersion   String?
  cpuUsage         Float                @default(0)
  ramUsage         Float                @default(0)
  ramTotal         Float                @default(0)
  diskUsage        Float                @default(0)
  diskTotal        Float                @default(0)
  netIn            Float                @default(0)
  netOut           Float                @default(0)
  uptime           Int                  @default(0)
  loadAvg          String               @default("")
  status           String               @default("offline")
  approved         Boolean              @default(false)
  alertsEnabled    Boolean              @default(false)
  addedById        String?
  planLink         String? // URL to the hosting plan / control panel
  lastSeen         DateTime             @default(now())
  createdAt        DateTime             @default(now())
  metrics          VpsMetric[]
  credentials      Credential[] // linked vault entries mirroring this server's secrets
  subscription     Service?             @relation("VpsSub") // billing row in the Services tab
  projects         Project[]            @relation("ProjectVpsServers")
  maintainers      User[]               @relation("VpsMaintainers")
  alerts           OperationalAlert[]
  alertPreferences VpsAlertPreference[]
}

model VpsAlertPreference {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vpsServerId   String
  vpsServer     VpsServer @relation(fields: [vpsServerId], references: [id], onDelete: Cascade)
  enabled       Boolean   @default(false)
  notifyOffline Boolean   @default(true)
  notifyCpu     Boolean   @default(true)
  notifyMemory  Boolean   @default(true)
  notifyDisk    Boolean   @default(true)
  notifyLoad    Boolean   @default(true)
  notifyProcess Boolean   @default(true)
  inApp         Boolean   @default(true)
  telegram      Boolean   @default(false)
  promptedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, vpsServerId])
  @@index([vpsServerId, enabled])
}

model FinanceSyncJob {
  id            String    @id @default(cuid())
  action        String
  actorName     String
  transactionId String?
  sendBackup    Boolean   @default(false)
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  completedAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
}

model VpsMetric {
  id        String    @id @default(cuid())
  serverId  String
  server    VpsServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  cpuUsage  Float     @default(0)
  ramUsage  Float     @default(0)
  ramTotal  Float     @default(0)
  diskUsage Float     @default(0)
  diskTotal Float     @default(0)
  netIn     Float     @default(0)
  netOut    Float     @default(0)
  uptime    Int       @default(0)
  load1     Float     @default(0)
  load5     Float     @default(0)
  load15    Float     @default(0)
  createdAt DateTime  @default(now())

  @@index([serverId, createdAt])
}
