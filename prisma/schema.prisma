generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DONOR
  DEV
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Currency {
  INR
  USD
}

enum PaymentMethod {
  UPI
  BMC
  BANK
  OTHER
}

enum Direction {
  IN
  OUT
}

enum TxStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TxType {
  DONATION
  EXPENSE
  SUBSCRIPTION
  OTHER
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum Frequency {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjStatus {
  ACTIVE
  ARCHIVED
  ON_HOLD
}

enum ReminderFreq {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

enum Channel {
  BOT
  WEB
  BOTH
}

model User {
  id           String     @id @default(cuid())
  telegramId   String     @unique
  telegramUser String
  name         String
  photoUrl     String?
  themeColor   String     @default("#6FD1D7")
  savedColors  String[]   @default([])
  chatId       String?
  roles        Role[]
  status       UserStatus @default(ACTIVE)
  dmPreferences String[] @default(["TX_APPROVED", "TX_REJECTED", "TASK_ASSIGNED", "REMINDER", "SYSTEM", "ROLE_ASSIGNED", "CREDENTIAL_ASSIGNED", "CREDENTIAL_REVIEWED", "USER_REGISTERED"])
  createdById  String?
  createdBy    User?      @relation("CreatedByAdmin", fields: [createdById], references: [id])
  createdUsers User[]     @relation("CreatedByAdmin")
  createdAt    DateTime   @default(now())

  otpCode      String?
  otpExpiresAt DateTime?

  transactionsCreated  Transaction[] @relation("TxCreatedBy")
  transactionsFrom     Transaction[] @relation("TxFromUser")
  transactionsReviewed Transaction[] @relation("TxReviewedBy")
  tasksAssigned        Task[]        @relation("TaskAssignee")
  tasksCreated         Task[]        @relation("TaskCreatedBy")
  remindersCreated     Reminder[]
  projectMembers       Project[]     @relation("ProjectMembers")
  credentialsCreated   Credential[]  @relation("CredCreatedBy")
  credentialsReviewed  Credential[]  @relation("CredReviewedBy")
  credentialAccess     Credential[]  @relation("CredentialAssignees")
  notifications        Notification[]
}

model Transaction {
  id          String        @id @default(cuid())
  amount      Decimal
  currency    Currency      @default(INR)
  method      PaymentMethod @default(UPI)
  direction   Direction
  type        TxType        @default(OTHER)
  fromUserId  String?
  fromUser    User?         @relation("TxFromUser", fields: [fromUserId], references: [id])
  description String
  proofFileId  String?
  attachments  String[]      @default([])
  date        DateTime      @default(now())
  status      TxStatus      @default(PENDING)
  reviewedById String?
  reviewedBy   User?        @relation("TxReviewedBy", fields: [reviewedById], references: [id])
  reviewNote   String?
  bmcEventId   String?      @unique
  createdById  String
  createdBy    User         @relation("TxCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())

  service      Service?     @relation("SubPaidTx")
  auditLogs    AuditLog[]
}

model Service {
  id              String     @id @default(cuid())
  category        String
  name            String
  columns         Json?
  entries         Json?
  // Optional subscription / cost tracking
  price           Decimal?
  currency        Currency?
  frequency       Frequency?
  planUrl         String?
  expiryDate      DateTime?
  lastRenewalDate DateTime?
  paidTxId        String?    @unique
  paidTransaction Transaction? @relation("SubPaidTx", fields: [paidTxId], references: [id])
  status          SubStatus?
  createdAt       DateTime   @default(now())
}

model Project {
  id          String     @id @default(cuid())
  name        String
  repoUrl     String?
  description String
  status      ProjStatus @default(ACTIVE)
  members     User[]     @relation("ProjectMembers")
  tasks       Task[]
  createdAt   DateTime   @default(now())
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#c8ff00")
  tasks Task[] @relation("TaskTags")
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id])
  title       String
  description String?
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  status      TaskStatus @default(BACKLOG)
  priority    Priority   @default(MEDIUM)
  startDate   DateTime?
  deadline    DateTime?
  parentId    String?
  parent      Task?      @relation("Subtasks", fields: [parentId], references: [id])
  subtasks    Task[]     @relation("Subtasks")
  tags        Tag[]      @relation("TaskTags")
  createdById String
  createdBy   User       @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
}

model Reminder {
  id            String       @id @default(cuid())
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])
  message       String
  frequency     ReminderFreq @default(ONCE)
  nextFire      DateTime
  channel       Channel      @default(BOTH)
  recipientRoles Role[]
  createdAt     DateTime     @default(now())
}

enum CredStatus {
  APPROVED
  PENDING
  REJECTED
}

model Credential {
  id          String     @id @default(cuid())
  platform    String
  label       String
  value       String
  assignees   User[]     @relation("CredentialAssignees")
  status      CredStatus @default(APPROVED)
  createdById String
  createdBy   User       @relation("CredCreatedBy", fields: [createdById], references: [id])
  reviewedById String?
  reviewedBy   User?     @relation("CredReviewedBy", fields: [reviewedById], references: [id])
  parentId    String?
  parent      Credential?  @relation("CredentialRevisions", fields: [parentId], references: [id])
  revisions   Credential[] @relation("CredentialRevisions")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String
  action        String
  entityType    String
  entityId      String
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  before        Json?
  after         Json?
  timestamp     DateTime @default(now())
}

enum NotifType {
  TX_APPROVED
  TX_REJECTED
  TASK_ASSIGNED
  REMINDER
  SYSTEM
  ROLE_ASSIGNED
  CREDENTIAL_ASSIGNED
  CREDENTIAL_REVIEWED
  USER_REGISTERED
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      NotifType
  title     String
  message   String
  read      Boolean   @default(false)
  entityId  String?
  priority  String    @default("NORMAL")
  createdAt DateTime  @default(now())
}

enum LoginTokenStatus {
  PENDING
  VERIFIED
  EXPIRED
}

model LoginToken {
  id         String           @id @default(cuid())
  nonce      String           @unique
  telegramId String?
  status     LoginTokenStatus @default(PENDING)
  expiresAt  DateTime
  createdAt  DateTime         @default(now())
}

model VpsServer {
  id          String   @id @default(cuid())
  name        String
  token       String   @unique
  provider    String   @default("")
  ip          String   @default("")
  platform    String   @default("")
  password    String   @default("")
  notes       String   @default("")
  specs       Json     @default("{}")
  cpuUsage    Float    @default(0)
  ramUsage    Float    @default(0)
  ramTotal    Float    @default(0)
  diskUsage   Float    @default(0)
  diskTotal   Float    @default(0)
  netIn       Float    @default(0)
  netOut      Float    @default(0)
  uptime      Int      @default(0)
  loadAvg     String   @default("")
  status      String   @default("offline")
  approved    Boolean  @default(false)
  addedById   String?
  lastSeen    DateTime @default(now())
  createdAt   DateTime @default(now())
}
