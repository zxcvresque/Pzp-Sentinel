DATABASE_URL="postgresql://user:password@localhost:5432/pzp_finance"
BOT_TOKEN="your-telegram-bot-token"
BOT_USERNAME="YourBotUsername"
BOT_WEBHOOK_SECRET="random-secret-string"
JWT_SECRET="random-jwt-secret-min-32-chars"
WEBAPP_URL="https://your-domain.com"

# Telegram group logging (create topics in your TG supergroup, use thread IDs)
TG_GROUP_ID="-100xxxxxxxxxx"
TG_TOPIC_AUDIT="6"
TG_TOPIC_TRANSACTIONS="12"
TG_TOPIC_SCREENSHOTS="18"
TG_TOPIC_BACKUPS="24"

# Read-only Google Sheets finance mirror + Telegram XLSX backups
GOOGLE_SHEETS_ID="your-spreadsheet-id"
GOOGLE_SERVICE_ACCOUNT_EMAIL="sentinel-sheets@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Razorpay Standard Checkout. Keep the secret server-side; only the Key ID is
# returned to Checkout. Use test keys locally, then replace both with live keys.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your-test-key-secret"
# Create a separate secret in Razorpay Dashboard -> Webhooks.
RAZORPAY_WEBHOOK_SECRET="generate-a-dedicated-webhook-secret"

# Donations group for public thank-yous (optional). If unset, thank-yous fall
# back to TG_GROUP_ID's General topic (useful for testing). Omit the topic id
# to post to the group's General topic.
TG_DONATION_GROUP_ID=""
TG_DONATION_TOPIC_ID=""

# GitHub immutable logs (fine-grained token, Contents read+write on Sentinel-Logs repo)
GITHUB_LOGS_TOKEN="ghp_your_token_here"

# GitHub Activity (org-wide feed on dev board)
GITHUB_ORG="your-org-or-username"
GITHUB_TOKEN="ghp_your_token_here"

# Field-level encryption key for credential/VPS secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENC_KEY=
