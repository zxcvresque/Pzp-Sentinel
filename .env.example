DATABASE_URL="postgresql://user:password@localhost:5432/pzp_finance"
BOT_TOKEN="your-telegram-bot-token"
BOT_USERNAME="YourBotUsername"
BOT_WEBHOOK_SECRET="random-secret-string"
JWT_SECRET="random-jwt-secret-min-32-chars"
WEBAPP_URL="https://your-domain.com"

# Telegram group logging (create topics in your TG supergroup, use thread IDs)
TG_GROUP_ID="-100xxxxxxxxxx"
TG_TOPIC_AUDIT="6"
TG_TOPIC_TRANSACTIONS="12"
TG_TOPIC_SCREENSHOTS="18"

# GitHub immutable logs (fine-grained token, Contents read+write on Sentinel-Logs repo)
GITHUB_LOGS_TOKEN="ghp_your_token_here"
